    "db:seed": "prisma db seed",
    "check": "npm run lint && npm run typecheck && npm test",
    "env:check": "tsx scripts/check-production-env.ts",
    "deploy:check": "npm run env:check && npm run check && npm run build"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.17.0",
  "dependencies": {
