    "@radix-ui/react-slot": "^1.3.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.4",
